# Keep shell scripts runnable in the Linux container regardless of host checkout settings
docker text eol=lf
docker-* text eol=lf

# Development-only files, excluded from the Composer dist archive
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/docker-conf export-ignore
/docker-compose.yaml export-ignore
/docker export-ignore
/docker-run export-ignore
/docker-test export-ignore
/docker-coverage export-ignore
/tests export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/phpstan.neon export-ignore
/phpstan-baseline.neon export-ignore
/stubs export-ignore
/phpunit.xml export-ignore
